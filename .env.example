# LLM provider
DRIFTGUARD_LLM_PROVIDER=openai
DRIFTGUARD_LLM_MODEL=
DRIFTGUARD_LLM_TEMPERATURE=0

# Set the API key for the selected provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub PR creation
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_BASE_BRANCH=main
GITHUB_TERRAFORM_FILE_PATH=main.tf
GITHUB_BRANCH_PREFIX=driftguard/remediate

# Local validation controls
TERRAFORM_INIT_TIMEOUT_SECONDS=120
TERRAFORM_VALIDATE_TIMEOUT_SECONDS=60

# Local/demo controls
DRIFTGUARD_DISABLE_PR_CREATION=false
DRIFTGUARD_MOCK_LLM=false
